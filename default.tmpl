    <!-- Minimal Structured Pre-game Overlay -->
    <div id="loader-overlay">
        <div class="loader-card">
            <div class="header-section">
                <h1 class="game-title">BraveRunner</h1>
                <div class="game-subtitle">2D Action Platformer</div>
            </div>

            <div class="loading-section">
                <div id="transfer" align="center">
                    <progress value="0" max="100" id="progress"></progress>
                    <div id="status">Loading game engine...</div>
                </div>
            </div>

            <!-- Start Button inside layout flow -->
            <div id="infobox">Click to Start</div>
        </div>
    </div>

    <!-- Game Canvas -->
    <canvas class="emscripten" id="canvas" width="1px" height="1px" oncontextmenu="event.preventDefault()" tabindex="1"></canvas>
    <canvas class="emscripten" id="canvas3d" width="1280px" height="720px" oncontextmenu="event.preventDefault()" tabindex="1" hidden></canvas>

    <div id="html"></div>

    <div id="crt" style="display:none;">
        <div id="system" hidden><button id="aiostop" disabled>AIO</button></div>
        <div id="box" hidden="true"><div id="info"></div><iframe id="iframe" name="iframe" src="https://pygame-web.github.io/cdn/0.9.3/empty.html"></iframe></div>
    </div>

    <div id="dlg" hidden><input type="file" id="dlg_multifile" multiple accept="image/*"></div>
    <div id="pyconsole" style="display:none;"><div id="terminal" tabIndex="1"></div></div>

    <script type="application/javascript">
    globalThis.__canvas_resized = (self, ecw, ech) => {}

    async function custom_onload(debug_hidden) {
        pyconsole.hidden = debug_hidden
        system.hidden = debug_hidden
        transfer.hidden = debug_hidden
        info.hidden = debug_hidden
        box.hidden = debug_hidden
        show_infobox()
    }

    function custom_prerun(){}
    function custom_postrun(){}

    function debug() {
        python.config.debug = true
        custom_onload(false)
        Module.PyRun_SimpleString("shell.uptime()")
        window_resize()
    }

    function info_inline(data){
        document.getElementById("info").innerHTML = data
    }

    const observer = new MutationObserver(() => {
        const infoboxEl = document.getElementById("infobox");
        if (infoboxEl && infoboxEl.style.display === "none") {
            const overlay = document.getElementById("loader-overlay");
            if (overlay) {
                overlay.style.opacity = "0";
                setTimeout(() => { overlay.style.display = "none"; }, 400);
            }
        }
    });
    const infoboxTarget = document.getElementById("infobox");
    if (infoboxTarget) {
        observer.observe(infoboxTarget, { attributes: true, attributeFilter: ["style"] });
    }
    </script>
</body>
